# ───────────────────────── Aegis environment ─────────────────────────
# Copy to packages/agent/.env and/or packages/web/.env.local as needed.

# ===== Chain =====
# 46630 = Robinhood Chain testnet (primary) · 421614 = Arbitrum Sepolia (fallback)
CHAIN_ID=421614
RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# ===== Deployed contracts =====
RISK_ENGINE_ADDRESS=
AEGIS_VAULT_ADDRESS=
ERC8004_IDENTITY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713

# ===== Oracle check =====
PRICE_FEED_ADDRESS=
EXPECTED_PRICE=

# ===== Keeper (agent session key — use a SCOPED key, never a main key) =====
KEEPER_PRIVATE_KEY=
PROTECTED_USER=

# ===== Deploy (Foundry) =====
PRIVATE_KEY=
KEEPER_ADDRESS=
SWAP_ROUTER_ADDRESS=
AAVE_POOL_ADDRESS=0x794a61358D6845594F94dc1DB02A252b5b4814aD
SEQUENCER_FEED_ADDRESS=

# ===== Sponsor integrations (optional) =====
FORTA_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
X402_PORT=4021
X402_PAY_TO=
X402_FACILITATOR_URL=https://x402.org/facilitator

# ===== Agent loop =====
POLL_INTERVAL_MS=15000

# ===== Web (NEXT_PUBLIC_* are exposed to the browser) =====
NEXT_PUBLIC_ENGINE_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_SOURCE_ASSET=
NEXT_PUBLIC_TARGET_ASSET=
NEXT_PUBLIC_ADAPTER=
NEXT_PUBLIC_PROTECTED_USER=
